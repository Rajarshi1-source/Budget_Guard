# Copy to deploy/k3s/.env.k3s on the VM (git-ignored by `.env.*`). Placeholders only: never commit
# real values. Every secret is in security-and-api.md §7 with its rotation steps.
DOCKERHUB_NS=yourdockerhubname
GITHUB_REPOSITORY=Rajarshi1-source/Budget_Guard
PUBLIC_URL=https://budgetguard.example.dev
KUBE_API_URL=https://k3s.example.dev:6443        # what GitHub-hosted runners use to reach the API server
CF_CREDENTIALS_FILE=/home/ubuntu/.cloudflared/budgetguard.json

PG_PASSWORD=                 # openssl rand -base64 32 (each of these)
BG_DB_APP_PASSWORD=
BG_DB_GRAFANA_PASSWORD=
BG_DB_AUTH_PASSWORD=
VALKEY_PASSWORD=
BG_ALERTMANAGER_TOKEN=
BG_DASHBOARD_TOKEN=
BETTER_AUTH_SECRET=
GRAFANA_ADMIN_PASSWORD=
SLACK_PAGE_URL=http://127.0.0.1:9/page
SLACK_TICKET_URL=http://127.0.0.1:9/ticket

BG_GITHUB_REPO_ID=           # gh api repos/$GITHUB_REPOSITORY --jq .id
BG_GITHUB_OWNER_ID=          # gh api users/<owner> --jq .id
BG_GITHUB_INSTALLATION_ID=   # App settings -> Install App -> the number in the URL
BG_GITHUB_APP_ID=
BG_GITHUB_APP_PRIVATE_KEY_FILE=/home/ubuntu/budgetguard-app.private-key.pem
BG_GITHUB_WEBHOOK_SECRET=
BG_APPROVER_IDS=[12345678]   # numeric GitHub user ids
GITHUB_CLIENT_ID=            # GitHub OAuth app for dashboard sign-in, scope read:user
GITHUB_CLIENT_SECRET=
