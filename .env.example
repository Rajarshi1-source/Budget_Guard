# Copy to .env for docker compose (deploy/compose). Placeholders only: never commit .env.
# Every secret here is listed with its rotation steps in
# .claude/skills/budgetguard-admission-gate/references/security-and-api.md §7.

# --- Data layer ---------------------------------------------------------------
PG_PASSWORD=change-me
BG_DATABASE_URL=postgresql+asyncpg://bg:change-me@timescaledb:5432/budgetguard
BG_VALKEY_URL=redis://valkey:6379/0
BG_PROMETHEUS_URL=http://prometheus:9090

# --- GitHub App (protection rule) ----------------------------------------------
BG_GITHUB_REPO=Rajarshi1-source/Budget_Guard
BG_GITHUB_REPO_ID=                  # gh api repos/Rajarshi1-source/Budget_Guard --jq .id
BG_GITHUB_OWNER_ID=                 # gh api users/Rajarshi1-source --jq .id
BG_GITHUB_INSTALLATION_ID=          # App settings -> Install App -> the number in the URL
BG_GITHUB_APP_ID=
BG_GITHUB_APP_PRIVATE_KEY=          # PEM, newlines as \n
BG_GITHUB_WEBHOOK_SECRET=
BG_GITHUB_WEBHOOK_SECRET_PREVIOUS=  # only during a rotation (security-and-api.md §6.1)

# --- Machine callers of the platform API ---------------------------------------
BG_ALERTMANAGER_TOKEN=              # same value in deploy/compose/bg_token
BG_DASHBOARD_TOKEN=                 # openssl rand -base64 32; same value as BUDGETGUARD_DASHBOARD_TOKEN
BG_APPROVER_IDS=[12345678]          # numeric GitHub user ids: gh api users/<login> --jq .id

# --- Services under test (demo profile only) -----------------------------------
BG_FAULTS_ADMIN=false               # true enables /admin/faults
BG_FAULTS_TOKEN=                    # X-BG-Fault-Token for /admin/faults (k6 and the Makefile send it)

# --- Dashboard (Next.js + Better Auth) -----------------------------------------
BUDGETGUARD_API=http://platform-api:8000
BUDGETGUARD_DASHBOARD_TOKEN=
AUTH_DATABASE_URL=postgresql://bg_auth:change-me@timescaledb:5432/budgetguard
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=                 # 32+ random bytes
GITHUB_CLIENT_ID=                   # GitHub OAuth app, scope read:user
GITHUB_CLIENT_SECRET=

# --- Brief writer (optional) ----------------------------------------------------
OPENAI_API_KEY=                     # empty = template briefs only (provider and model: platform/config/llm.yaml)
BG_SLACK_BRIEFS_URL=                # #bg-briefs incoming webhook; empty = briefs stored, not posted

# --- Public profile (Cloudflare Tunnel) -----------------------------------------
CF_TUNNEL_TOKEN=
